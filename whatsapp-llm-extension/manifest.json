{
  "manifest_version": 3,
  "name": "WhatsApp Local AI Autopilot",
  "version": "3.0.1",
  "description": "Draft or send WhatsApp replies with local Llama models through Ollama, or an optional API provider.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/robot_icon.png", "48": "icons/robot_icon.png", "128": "icons/robot_icon.png" }
  },
  "icons": { "16": "icons/robot_icon.png", "48": "icons/robot_icon.png", "128": "icons/robot_icon.png" }
}
